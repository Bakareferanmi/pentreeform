{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://pentreeform.bakareferanmi96.workers.dev/api/:path*"
    },
    {
      "source": "/f/:path*",
      "destination": "https://pentreeform.bakareferanmi96.workers.dev/f/:path*"
    },
    {
      "source": "/demo",
      "destination": "/index.html"
    },
    {
      "source": "/demo/",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/privacy/",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/terms/",
      "destination": "/index.html"
    },
    {
      "source": "/support",
      "destination": "/index.html"
    },
    {
      "source": "/support/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/f/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
